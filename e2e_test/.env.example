# ARTEMIS E2E — biến môi trường (KHÔNG commit file .env thật)
# Copy sang `.env` rồi điền giá trị.

# ARTEMIS host (server chạy `uv run artemis ui` hoặc `artemis serve`)
ARTEMIS_HOST=http://127.0.0.1:8000

# Serial device: `adb devices` → ví dụ emulator-5554
DEVICE_SERIAL=emulator-5554

# Key mô hình chỉ đặt trong .env của HOST ARTEMIS, không cần ở harness.

# App dưới test
APP_PACKAGE=com.example.prm323_lab3

# Tài khoản kiểm thử riêng (guide tr.2): email Google phụ, KHÔNG dùng tài khoản cá nhân
TEST_ACCOUNT_EMAIL=tai-khoan-test@...

# Thư mục xuất evidence (mặc định ../evidence/artemis)
EVIDENCE_DIR=

# Chỉ bật với tài khoản thử riêng được phép thay đổi phiên và tạo fixture
E2E_ALLOW_AUTH_CHANGES=0
